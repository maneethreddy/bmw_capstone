# BMW Capstone P11 — API Environment Configuration
# Copy this file to .env in the api/ directory and fill in your values.
# The .env file is excluded by .gitignore and is NEVER committed to Git.
#
# AWS credentials are resolved from the standard credential chain:
#   1. AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY environment variables
#   2. ~/.aws/credentials file (configured via `aws configure`)
#   3. IAM instance/task role (EC2/ECS/Lambda)
# NEVER hard-code AWS credentials in source files or environment files.

# ---------------------------------------------------------------------------
# AWS region (must match the region where S3/Athena/Glue are provisioned)
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1

# ---------------------------------------------------------------------------
# S3 bucket — used as the Athena query results output location
# ---------------------------------------------------------------------------
S3_BUCKET=m-bmw-capstone-p11-raw

# ---------------------------------------------------------------------------
# Athena
# ---------------------------------------------------------------------------
ATHENA_DATABASE=bmw_capstone_p11
ATHENA_TABLE=telemetry_aggregates

# Prefix within S3_BUCKET where Athena writes query result CSVs
ATHENA_RESULTS_PREFIX=athena-results
