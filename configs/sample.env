# BMW Capstone P11 — Environment Configuration
# Copy this file to .env in the project root and fill in your values.
# The .env file is excluded by .gitignore and is NEVER committed to Git.

# ---------------------------------------------------------------------------
# Kafka
# ---------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=bmw-telemetry

# ---------------------------------------------------------------------------
# Spark
# ---------------------------------------------------------------------------
SPARK_MASTER=local[*]
SPARK_WINDOW_DURATION=5 minutes
SPARK_WATERMARK_DELAY=2 minutes
SPARK_CHECKPOINT_LOCATION=./checkpoints/bmw-telemetry

# JAVA_HOME — required for PySpark (Java 17 recommended)
# On Mac with Homebrew OpenJDK 17:
#   export JAVA_HOME=/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home
# On Windows (BMW laptop — set in System env vars or PowerShell session):
#   $env:JAVA_HOME = "C:\Program Files\Eclipse Adoptium\jdk-17..."
# JAVA_HOME is NOT set in this file to keep it portable.

# ---------------------------------------------------------------------------
# AWS — required for S3 and CloudWatch sinks
# Leave S3_BUCKET empty to disable the S3 sink.
# Leave CLOUDWATCH_ENABLED=false to disable CloudWatch metrics.
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1
S3_BUCKET=
CLOUDWATCH_ENABLED=false

# AWS credentials are resolved from the standard credential chain:
#   1. AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY environment variables
#   2. ~/.aws/credentials file (configured via `aws configure`)
#   3. IAM instance/task role (EC2/ECS/Lambda)
# NEVER hard-code AWS credentials in source files.

# ---------------------------------------------------------------------------
# Athena (no credentials needed beyond standard AWS credential chain)
# ---------------------------------------------------------------------------
ATHENA_DATABASE=bmw_capstone_p11
ATHENA_TABLE=telemetry_aggregates
# S3 location for Athena query results (optional, defaults to Athena workgroup setting)
# ATHENA_OUTPUT_LOCATION=s3://<YOUR_BUCKET>/athena-results/

# ---------------------------------------------------------------------------
# Snowflake — NOT USED in this project
# Athena is used as the analytical platform instead.
# These variables are intentionally left blank.
# ---------------------------------------------------------------------------
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_WAREHOUSE=
